<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane onMouseClicked="#selectedTaskCard" prefHeight="142.0" prefWidth="273.0" styleClass="task-card" stylesheets="@taskCardUI.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.flora.Features.Task.UI.Card.TaskCardUI_Controller">
   <children>
      <Label fx:id="dueDate" layoutX="209.0" layoutY="11.0" onMouseClicked="#selectedTaskCard" styleClass="due-badge" text="25 May" textFill="#f8eded">
         <padding>
            <Insets bottom="5.0" left="8.0" right="8.0" top="5.0" />
         </padding>
         <font>
            <Font size="11.0" />
         </font>
      </Label>
      <Label fx:id="taskStatus" alignment="CENTER" layoutX="166.0" layoutY="92.0" onMouseClicked="#selectedTaskCard" prefHeight="27.0" prefWidth="88.0" styleClass="status-progress" text="IN_PROGRESS" textFill="#33ff00">
         <padding>
            <Insets bottom="5.0" left="8.0" right="8.0" top="5.0" />
         </padding>
         <font>
            <Font size="12.0" />
         </font>
      </Label>
      <Label fx:id="subTitle" layoutX="14.0" layoutY="39.0" prefHeight="23.0" prefWidth="125.0" styleClass="task-card-sub" stylesheets="@taskCardUI.css" text="Add Navigation bar">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="taskTitle" layoutX="15.0" layoutY="12.0" prefHeight="24.0" prefWidth="171.0" styleClass="task-card-title" stylesheets="@taskCardUI.css" text="Label" />
   </children>
</AnchorPane>
