<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="115.0" prefWidth="640.0"
        styleClass="task-card"
        stylesheets="@taskCardUI.css"
        xmlns="http://javafx.com/javafx/23.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.flora.Features.Task.UI.Card.TaskCardUI_Controller"
        onMouseClicked="#selectedTaskCard">

   <children>

      <VBox
              spacing="0.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

         <!-- ── Top section: title + due badge ── -->
         <HBox alignment="CENTER_LEFT" spacing="8.0" VBox.vgrow="ALWAYS">
            <padding><Insets top="14.0" left="16.0" right="14.0" bottom="6.0"/></padding>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <Label fx:id="taskTitle" styleClass="task-card-title" text="Task Title" wrapText="false"
                      maxWidth="380.0">
                  <font><Font name="System Bold" size="14.0"/></font>
               </Label>
               <Label fx:id="subTitle" styleClass="task-card-sub" text="Subtitle / description"
                      wrapText="false" maxWidth="380.0">
                  <font><Font size="12.0"/></font>
               </Label>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Due date badge (top-right) -->
            <Label fx:id="dueDate" styleClass="due-badge" text="No due date">
               <padding><Insets top="4.0" bottom="4.0" left="8.0" right="8.0"/></padding>
               <font><Font size="10.0"/></font>
            </Label>
         </HBox>

         <Pane styleClass="card-divider" prefHeight="1.0" maxHeight="1.0"/>

         <HBox alignment="CENTER_LEFT" spacing="8.0" prefHeight="38.0">
            <padding><Insets top="8.0" left="16.0" right="14.0" bottom="8.0"/></padding>

            <Pane fx:id="avatarDot" styleClass="avatar-dot"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="taskStatus" styleClass="status-todo" text="To Do"
                   alignment="CENTER" onMouseClicked="#toggleStatus">
               <padding><Insets top="5.0" bottom="5.0" left="10.0" right="10.0"/></padding>
               <font><Font name="System Bold" size="11.0"/></font>
            </Label>
         </HBox>

      </VBox>
   </children>
</AnchorPane>
