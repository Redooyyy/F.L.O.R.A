<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane
        fx:id="projectDetailRoot"
        xmlns="http://javafx.com/javafx/23.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.flora.Features.Project.UI.ProjectDetailUI_Controller"
        prefHeight="508.0" prefWidth="1102.0"
        styleClass="root-pane"
        stylesheets="@style.css"
        translateX="1102.0">

    <children>


        <AnchorPane layoutX="0.0" layoutY="0.0"
                    prefHeight="508.0" prefWidth="820.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <HBox layoutX="12.0" layoutY="10.0"
                  prefHeight="44.0" prefWidth="796.0"
                  alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <Button fx:id="backBtn" mnemonicParsing="false"
                            onAction="#closeDetail"
                            prefHeight="32.0" prefWidth="70.0"
                            styleClass="slide-close-btn" text="← Back">
                        <font><Font name="System Bold" size="13.0"/></font>
                    </Button>
                    <Label fx:id="detailProjectName" text="Project Name"
                           prefHeight="36.0" prefWidth="360.0"
                           styleClass="detail-page-title">
                        <font><Font name="System Bold" size="20.0"/></font>
                    </Label>
                    <Label fx:id="roleBadge" text="LEADER"
                           styleClass="role-badge-leader"
                           prefHeight="28.0" prefWidth="90.0"
                           alignment="CENTER">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                </children>
            </HBox>

            <HBox layoutX="12.0" layoutY="58.0"
                  prefHeight="36.0" prefWidth="796.0" spacing="8.0">
                <children>
                    <Button fx:id="tabTasks" mnemonicParsing="false"
                            onAction="#showTasksTab"
                            prefHeight="34.0" prefWidth="110.0"
                            styleClass="tab-btn-active" text="📋  Tasks">
                        <font><Font name="System Bold" size="13.0"/></font>
                    </Button>
                    <Button fx:id="tabMembers" mnemonicParsing="false"
                            onAction="#showMembersTab"
                            prefHeight="34.0" prefWidth="120.0"
                            styleClass="tab-btn" text="👥  Members">
                        <font><Font name="System Bold" size="13.0"/></font>
                    </Button>
                    <Button fx:id="tabBugs" mnemonicParsing="false"
                            onAction="#showBugsTab"
                            prefHeight="34.0" prefWidth="110.0"
                            styleClass="tab-btn" text="🐛  Bugs">
                        <font><Font name="System Bold" size="13.0"/></font>
                    </Button>
                </children>
            </HBox>

            <AnchorPane layoutX="12.0" layoutY="98.0"
                        prefHeight="1.0" prefWidth="796.0"
                        styleClass="slide-divider"/>

            <AnchorPane fx:id="tasksTab"
                        layoutX="0.0" layoutY="103.0"
                        prefHeight="395.0" prefWidth="820.0"
                        visible="true">
                <children>

                    <HBox fx:id="taskActionBar"
                          layoutX="12.0" layoutY="8.0"
                          prefHeight="36.0" prefWidth="796.0"
                          spacing="10.0" alignment="CENTER_LEFT">
                        <children>

                            <Button fx:id="addTaskToggleBtn"
                                    mnemonicParsing="false"
                                    onAction="#toggleAddTaskPanel"
                                    prefHeight="34.0"
                                    styleClass="btn-accept"
                                    text="➕  Add Task"
                                    visible="false" managed="false">
                                <font><Font name="System Bold" size="12.0"/></font>
                                <padding><Insets top="4.0" bottom="4.0" left="14.0" right="14.0"/></padding>
                            </Button>

                            <HBox HBox.hgrow="ALWAYS"/>

                            <Label text="View:" styleClass="card-section-label">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <MenuButton fx:id="filterMenuBtn"
                                        text="📋  All Tasks"
                                        prefHeight="34.0"
                                        styleClass="task-filter-menu-btn"
                                        mnemonicParsing="false">
                                <font><Font name="System Bold" size="12.0"/></font>
                                <items>
                                    <MenuItem fx:id="menuMyTasks"
                                              text="👤  My Tasks"
                                              onAction="#filterMyTasks"/>
                                    <MenuItem fx:id="menuAllTasks"
                                              text="📋  All Tasks"
                                              onAction="#filterAllTasks"/>
                                    <MenuItem fx:id="menuCompleted"
                                              text="✅  Completed"
                                              onAction="#filterCompleted"/>
                                    <MenuItem fx:id="menuDue"
                                              text="⏳  Due / Overdue"
                                              onAction="#filterDue"/>
                                    <MenuItem fx:id="menuByAssignee"
                                              text="👥  By Assignee"
                                              onAction="#filterByAssignee"/>
                                    <MenuItem fx:id="menuDrafts"
                                              text="✏  Drafts"
                                              onAction="#filterDrafts"/>
                                </items>
                                <padding><Insets top="4.0" bottom="4.0" left="12.0" right="12.0"/></padding>
                            </MenuButton>

                        </children>
                    </HBox>

                    <VBox fx:id="addTaskPanel"
                          layoutX="12.0" layoutY="52.0"
                          prefWidth="796.0"
                          styleClass="add-task-panel"
                          visible="false" managed="false"
                          spacing="10.0">
                        <padding><Insets top="12.0" bottom="12.0" left="14.0" right="14.0"/></padding>
                        <children>

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Label text="New Task" styleClass="detail-page-title">
                                        <font><Font name="System Bold" size="14.0"/></font>
                                    </Label>
                                    <Button fx:id="modeAssignBtn"
                                            mnemonicParsing="false"
                                            onAction="#switchToAssignMode"
                                            prefHeight="26.0"
                                            styleClass="task-filter-btn-active"
                                            text="Assign Now">
                                        <font><Font name="System Bold" size="11.0"/></font>
                                        <padding><Insets top="3.0" bottom="3.0" left="10.0" right="10.0"/></padding>
                                    </Button>
                                    <Button fx:id="modeDraftBtn"
                                            mnemonicParsing="false"
                                            onAction="#switchToDraftMode"
                                            prefHeight="26.0"
                                            styleClass="task-filter-btn"
                                            text="Save as Draft">
                                        <font><Font name="System Bold" size="11.0"/></font>
                                        <padding><Insets top="3.0" bottom="3.0" left="10.0" right="10.0"/></padding>
                                    </Button>
                                    <HBox HBox.hgrow="ALWAYS"/>
                                    <Button mnemonicParsing="false"
                                            onAction="#toggleAddTaskPanel"
                                            styleClass="slide-close-btn"
                                            text="✕">
                                        <padding><Insets top="3.0" bottom="3.0" left="8.0" right="8.0"/></padding>
                                    </Button>
                                </children>
                            </HBox>

                            <HBox fx:id="assignFields"
                                  spacing="8.0" alignment="CENTER_LEFT"
                                  visible="true" managed="true">
                                <children>
                                    <TextField fx:id="taskTitleInput"
                                               promptText="Task title..."
                                               prefHeight="34.0" prefWidth="220.0"
                                               styleClass="modal-text-field"/>
                                    <TextField fx:id="taskAssigneeInput"
                                               promptText="Assign to username..."
                                               prefHeight="34.0" prefWidth="180.0"
                                               styleClass="modal-text-field"/>
                                    <Label fx:id="assignDeadlineChip"
                                           text="📅  Set deadline"
                                           styleClass="deadline-chip-btn"
                                           onMouseClicked="#toggleAssignDeadline">
                                        <padding><Insets top="7.0" bottom="7.0" left="12.0" right="12.0"/></padding>
                                    </Label>
                                    <Button mnemonicParsing="false"
                                            onAction="#assignTask"
                                            prefHeight="34.0"
                                            styleClass="btn-accept" text="✦  Assign">
                                        <font><Font name="System Bold" size="12.0"/></font>
                                        <padding><Insets top="4.0" bottom="4.0" left="14.0" right="14.0"/></padding>
                                    </Button>
                                </children>
                            </HBox>

                            <HBox fx:id="draftFields"
                                  spacing="8.0" alignment="CENTER_LEFT"
                                  visible="false" managed="false">
                                <children>
                                    <TextField fx:id="draftTitleInput"
                                               promptText="Task title (assign later)..."
                                               prefHeight="34.0" prefWidth="280.0"
                                               styleClass="modal-text-field"/>
                                    <Label fx:id="draftDeadlineChip"
                                           text="📅  Set deadline"
                                           styleClass="deadline-chip-btn"
                                           onMouseClicked="#toggleDraftDeadline">
                                        <padding><Insets top="7.0" bottom="7.0" left="12.0" right="12.0"/></padding>
                                    </Label>
                                    <Button mnemonicParsing="false"
                                            onAction="#saveDraftTask"
                                            prefHeight="34.0"
                                            styleClass="update-btn" text="📌  Save Draft">
                                        <font><Font name="System Bold" size="12.0"/></font>
                                        <padding><Insets top="4.0" bottom="4.0" left="14.0" right="14.0"/></padding>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>


                    <ScrollPane fx:id="taskScroll"
                                layoutX="12.0" layoutY="52.0"
                                prefHeight="337.0" prefWidth="796.0"
                                styleClass="detail-scroll"
                                AnchorPane.bottomAnchor="6.0"
                                AnchorPane.leftAnchor="12.0"
                                AnchorPane.rightAnchor="12.0"
                                AnchorPane.topAnchor="52.0">
                        <content>
                            <VBox fx:id="taskList" spacing="8.0">
                                <padding><Insets top="6.0" bottom="6.0"/></padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                </children>
            </AnchorPane>

            <AnchorPane fx:id="membersTab"
                        layoutX="0.0" layoutY="103.0"
                        prefHeight="395.0" prefWidth="820.0"
                        visible="false">
                <children>
                    <HBox fx:id="inviteRow"
                          layoutX="12.0" layoutY="8.0"
                          prefHeight="38.0" prefWidth="796.0"
                          spacing="8.0" alignment="CENTER_LEFT">
                        <children>
                            <TextField fx:id="inviteSearchField"
                                       promptText="Search by username to invite..."
                                       prefHeight="36.0" prefWidth="320.0"
                                       styleClass="modal-text-field"/>
                            <Button mnemonicParsing="false"
                                    onAction="#sendInvite"
                                    prefHeight="36.0" prefWidth="130.0"
                                    styleClass="btn-accept" text="✉  Send Invite">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Button>
                            <Label fx:id="inviteFeedback" text=""
                                   styleClass="modal-field-label"
                                   prefHeight="36.0" prefWidth="200.0"/>
                        </children>
                    </HBox>
                    <ScrollPane fx:id="memberScroll"
                                layoutX="12.0" layoutY="54.0"
                                prefHeight="335.0" prefWidth="796.0"
                                styleClass="detail-scroll"
                                AnchorPane.bottomAnchor="6.0"
                                AnchorPane.leftAnchor="12.0"
                                AnchorPane.rightAnchor="12.0"
                                AnchorPane.topAnchor="54.0">
                        <content>
                            <VBox fx:id="memberList" spacing="8.0">
                                <padding><Insets top="6.0" bottom="6.0"/></padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </AnchorPane>

            <AnchorPane fx:id="bugsTab"
                        layoutX="0.0" layoutY="103.0"
                        prefHeight="395.0" prefWidth="820.0"
                        visible="false">
                <children>
                    <HBox fx:id="reportBugRow"
                          layoutX="12.0" layoutY="8.0"
                          prefHeight="38.0" prefWidth="796.0"
                          spacing="8.0" alignment="CENTER_LEFT">
                        <children>
                            <TextField fx:id="bugTitleInput"
                                       promptText="Describe the bug..."
                                       prefHeight="36.0" prefWidth="320.0"
                                       styleClass="modal-text-field"/>
                            <Button mnemonicParsing="false"
                                    onAction="#reportBug"
                                    prefHeight="36.0" prefWidth="130.0"
                                    styleClass="btn-decline" text="🐛  Report Bug">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Button>
                        </children>
                    </HBox>

                    <HBox fx:id="bugFilterBar"
                          layoutX="12.0" layoutY="52.0"
                          prefHeight="34.0" prefWidth="796.0"
                          spacing="8.0" alignment="CENTER_LEFT">
                        <children>
                            <Button fx:id="bugFilterAll"
                                    mnemonicParsing="false"
                                    onAction="#bugFilterAll"
                                    prefHeight="30.0"
                                    styleClass="task-filter-btn-active"
                                    text="All">
                                <font><Font name="System Bold" size="11.0"/></font>
                                <padding><Insets top="4.0" bottom="4.0" left="12.0" right="12.0"/></padding>
                            </Button>
                            <Button fx:id="bugFilterOpen"
                                    mnemonicParsing="false"
                                    onAction="#bugFilterOpen"
                                    prefHeight="30.0"
                                    styleClass="task-filter-btn"
                                    text="🔴  Open">
                                <font><Font name="System Bold" size="11.0"/></font>
                                <padding><Insets top="4.0" bottom="4.0" left="12.0" right="12.0"/></padding>
                            </Button>
                            <Button fx:id="bugFilterClosed"
                                    mnemonicParsing="false"
                                    onAction="#bugFilterClosed"
                                    prefHeight="30.0"
                                    styleClass="task-filter-btn"
                                    text="✅  Closed">
                                <font><Font name="System Bold" size="11.0"/></font>
                                <padding><Insets top="4.0" bottom="4.0" left="12.0" right="12.0"/></padding>
                            </Button>
                        </children>
                    </HBox>

                    <ScrollPane fx:id="bugScroll"
                                layoutX="12.0" layoutY="92.0"
                                prefHeight="297.0" prefWidth="796.0"
                                styleClass="detail-scroll"
                                AnchorPane.bottomAnchor="6.0"
                                AnchorPane.leftAnchor="12.0"
                                AnchorPane.rightAnchor="12.0"
                                AnchorPane.topAnchor="92.0">
                        <content>
                            <VBox fx:id="bugList" spacing="8.0">
                                <padding><Insets top="6.0" bottom="6.0"/></padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </AnchorPane>

        </AnchorPane>

        <AnchorPane layoutX="820.0" layoutY="0.0"
                    prefHeight="508.0" prefWidth="282.0"
                    styleClass="sidebar-panel"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Project Info"
                       layoutX="18.0" layoutY="18.0"
                       styleClass="detail-page-title">
                    <font><Font name="System Bold" size="16.0"/></font>
                </Label>
                <AnchorPane layoutX="12.0" layoutY="44.0"
                            prefHeight="1.0" prefWidth="258.0"
                            styleClass="slide-divider"/>
                <VBox layoutX="12.0" layoutY="54.0"
                      prefWidth="258.0" spacing="14.0">
                    <children>
                        <VBox styleClass="info-row-box" spacing="3.0">
                            <Label text="Project Lead" styleClass="modal-field-label">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <Label fx:id="infoLeader" text="—"
                                   styleClass="info-val-label" textFill="#EDE9F6">
                                <font><Font name="System Bold" size="14.0"/></font>
                            </Label>
                        </VBox>
                        <VBox styleClass="info-row-box" spacing="3.0">
                            <Label text="Created" styleClass="modal-field-label">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <Label fx:id="infoCreated" text="—"
                                   styleClass="info-val-label" textFill="#EDE9F6">
                                <font><Font size="13.0"/></font>
                            </Label>
                        </VBox>
                        <VBox styleClass="info-row-box" spacing="3.0">
                            <Label text="Members" styleClass="modal-field-label">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <Label fx:id="infoMemberCount" text="—"
                                   styleClass="info-val-label" textFill="#EDE9F6">
                                <font><Font name="System Bold" size="14.0"/></font>
                            </Label>
                        </VBox>
                        <VBox styleClass="info-row-box" spacing="3.0">
                            <Label text="Description" styleClass="modal-field-label">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <Label fx:id="infoDescription" text="—"
                                   styleClass="info-val-label" textFill="#C4B5F5"
                                   wrapText="true" prefWidth="238.0">
                                <font><Font size="13.0"/></font>
                            </Label>
                        </VBox>
                        <AnchorPane prefHeight="1.0" prefWidth="258.0"
                                    styleClass="slide-divider"/>
                        <HBox spacing="10.0">
                            <children>
                                <VBox styleClass="stat-box" prefWidth="118.0"
                                      alignment="CENTER" spacing="2.0">
                                    <padding><Insets top="10.0" bottom="10.0" left="8.0" right="8.0"/></padding>
                                    <Label fx:id="statTasks" text="0"
                                           textFill="#EDE9F6" alignment="CENTER">
                                        <font><Font name="System Bold" size="22.0"/></font>
                                    </Label>
                                    <Label text="Tasks" styleClass="modal-field-label" alignment="CENTER"/>
                                </VBox>
                                <VBox styleClass="stat-box" prefWidth="118.0"
                                      alignment="CENTER" spacing="2.0">
                                    <padding><Insets top="10.0" bottom="10.0" left="8.0" right="8.0"/></padding>
                                    <Label fx:id="statBugs" text="0"
                                           textFill="#F87171" alignment="CENTER">
                                        <font><Font name="System Bold" size="22.0"/></font>
                                    </Label>
                                    <Label text="Bugs" styleClass="modal-field-label" alignment="CENTER"/>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
